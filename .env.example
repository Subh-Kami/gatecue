# Copy to .env and fill in. .env is never committed.
STRIPE_SECRET_KEY=          # Stripe test-mode key (sk_test_...) for flight checkout
RAPIDAPI_KEY=               # AeroDataBox via RapidAPI, for live flight schedules and status
# GATECUE_SCHEDULE=live      # serve:demo uses the built-in demo schedule unless this is set

# The model that drives the simulator (GateCue itself works with any MCP host).
ANTHROPIC_API_KEY=          # set this to use Claude through the Anthropic API
# GC_BRAIN=anthropic        # anthropic | bedrock | scripted (default: anthropic if the key is set, else scripted)
# GC_MODEL=claude-haiku-4-5 # e.g. claude-sonnet-5-5, or for bedrock: us.amazon.nova-2-lite-v1:0
# GC_AGENT_PER_MIN=30       # model calls per minute per visitor
# GC_AGENT_PER_DAY=2000     # model calls per day in total (protects a public deployment)

# AWS (uses your `aws login` session). serve:demo turns this on by default.
# GC_AWS=1                  # DynamoDB memory + Amazon Location drive times
# GC_MEMORY_TABLE=gatecue-memory
# AWS_REGION=us-east-1
# Use a named AWS CLI profile when your default login is a different account (aws login --profile gatecue --remote)
# AWS_PROFILE=gatecue

# Trip-update emails (Amazon SES, needs GC_AWS=1). In the SES sandbox the address must be verified first.
# GC_TRAVELLER_EMAIL=you@example.com   # where GateCue sends plans and booking confirmations
# GC_SES_FROM=you@example.com          # sender; defaults to GC_TRAVELLER_EMAIL

# Ride handoff: your Uber developer app's client ID (public, not a secret)
# UBER_CLIENT_ID=
