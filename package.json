{
  "name": "gatecue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:views": "node scripts/build-views.mjs",
    "build:host": "node scripts/build-host.mjs",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "test:e2e": "tsx tests/e2e-client.ts",
    "check:keys": "node --env-file=.env scripts/check-keys.mjs",
    "build": "node scripts/build-views.mjs && node scripts/build-host.mjs",
    "test": "./scripts/test.sh",
    "serve:demo": "./scripts/serve-demo.sh",
    "stop": "lsof -ti tcp:8787 | xargs kill 2>/dev/null; echo stopped",
    "check:aws": "node scripts/check-aws.mjs",
    "test:agent": "node tests/agent.test.mjs",
    "test:aws": "tsx --env-file-if-exists=.env tests/aws-live.ts",
    "test:email": "tsx --env-file-if-exists=.env tests/email-live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1145.0",
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/client-geo-routes": "^3.1145.0",
    "@aws-sdk/client-sesv2": "^3.1145.0",
    "@aws-sdk/client-sts": "^3.1145.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
